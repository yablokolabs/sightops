# SightOps environment template — copy to .env and fill in.
#
#   cp .env.example .env
#
# `.env` is git-ignored and `scripts/scan_secrets.py` fails if any .env file is ever
# tracked. Nothing here is required: with no keys at all the backend still runs, the
# agent uses its deterministic policy and the interface says voice guidance is
# unavailable. All three keys are used server-side only — no key reaches the browser.
#
# The backend also reads these three names from $SIGHTOPS_ENV_FILE, which defaults to
# ~/.hermes/.env, so a machine that already keeps them there needs no project .env.

# Nebius AI Studio — reasoning and multimodal interpretation.
NEBIUS_API_KEY=

# ElevenLabs — spoken guidance. Premade voices only on a free plan; see README.
ELEVENLABS_API_KEY=

# Tavily — technical research tool available to the agent.
TAVILY_API_KEY=


# --- Optional settings (defaults shown) ------------------------------------
# Every backend setting is overridable with a SIGHTOPS_ prefix.
#
# SIGHTOPS_DATA_DIR=/absolute/path/to/data       # SQLite database and evidence
# SIGHTOPS_ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
# SIGHTOPS_NEBIUS_MODEL=Qwen/Qwen3.5-397B-A17B
# SIGHTOPS_AGENT_STEP_TIMEOUT_SECONDS=90
#
# The web client's dev and preview servers proxy /api and /health here:
# SIGHTOPS_BACKEND=http://127.0.0.1:8000
